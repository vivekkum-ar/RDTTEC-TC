# Copy this file to .env and fill in real values. NEVER commit .env or service-account.json.

# Admin login (used by the client bundle — VITE_ prefix is required here)
VITE_ADMIN_EMAIL=admin@example.com
VITE_ADMIN_PASSWORD=vivek123

# Google Sheets config (used by the API server)
VITE_SPREADSHEET_ID=1rwOW80sVGXLBzjXJq6bFzuzralkHbgGCzKJkG9v6kjw
VITE_SHEET_NAME=TC Data

# Service account credentials — choose ONE of the two options below.

# OPTION 1 (preferred for Vercel/production): full service account JSON as a string.
# Set this in your Vercel project settings, NOT in a committed file.
# No VITE_ prefix, so it is never bundled into the client.
SA_KEY_JSON={"type":"service_account","client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","project_id":"..."}

# OPTION 2 (local development only): path to a gitignored service-account.json file.
SA_KEY_FILE=service-account.json
